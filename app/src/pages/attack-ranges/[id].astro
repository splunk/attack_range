---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchAttackRangeStatus } from '../../utils/api-server';
import type { AttackRange } from '../../utils/api-server';

export const prerender = false;

const { id } = Astro.params;

let attackRange: AttackRange | null = null;
let error: string | null = null;

if (id) {
	try {
		attackRange = await fetchAttackRangeStatus(id);
	} catch (e) {
		error = e instanceof Error ? e.message : 'Failed to load attack range';
	}
} else {
	error = 'Attack range ID is required';
}
---

<BaseLayout title={attackRange ? (attackRange.attack_range_name || `Attack Range ${attackRange.attack_range_id}`) : 'Attack Range Details'} currentPath="/attack-ranges">
	<div class="page-header">
		<a href="/attack-ranges" class="back-button">
			← Back to Attack Ranges
		</a>
		<div class="title-row">
			{attackRange && attackRange.status === 'running' ? (
				<span class="editable-name" data-id={attackRange.attack_range_id}>
					<h1 class="editable-title">{attackRange.attack_range_name || 'Attack Range Details'}</h1>
					<button class="edit-name-btn" type="button" title="Edit name">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M11.333 2.00001C11.5084 1.82445 11.7163 1.68605 11.9447 1.59331C12.1731 1.50057 12.4173 1.45557 12.6637 1.46131C12.91 1.46705 13.1519 1.52337 13.375 1.62668C13.5981 1.72999 13.7975 1.87797 13.9613 2.04176C14.1251 2.20554 14.2501 2.40494 14.3534 2.62805C14.4567 2.85116 14.513 3.09305 14.5188 3.33939C14.5245 3.58573 14.4795 3.82994 14.3868 4.05834C14.294 4.28674 14.1556 4.49464 13.98 4.67001L13.333 5.31668L10.6867 2.67001L11.333 2.00001ZM9.54 3.79334L12.1867 6.44001L6.18667 12.44H3.54V9.79334L9.54 3.79334Z" fill="currentColor"/>
						</svg>
					</button>
				</span>
			) : (
				<h1>{attackRange && attackRange.attack_range_name ? attackRange.attack_range_name : 'Attack Range Details'}</h1>
			)}
		</div>
		{attackRange && (
			<p class="subtitle">{attackRange.attack_range_id || 'Unknown ID'}</p>
		)}
	</div>

	{error && (
		<div class="error-message">
			<p>Error: {error}</p>
			<a href="/attack-ranges" class="back-link">← Back to Attack Ranges</a>
		</div>
	)}

	{attackRange && (
		<div class="detail-view">
			<div class="detail-section basic-info-section">
				<div class="basic-info-header">
					<h3>Basic Information</h3>
					{['queued', 'build_vpn', 'build_lab'].includes(attackRange.status) ? (
						<button
							class="btn-warning abort-button"
							data-id={attackRange.attack_range_id}
							disabled={attackRange.terraform_running}
							title={attackRange.terraform_running ? 'Abort is not allowed while Terraform is provisioning infrastructure' : undefined}
						>
							{attackRange.terraform_running ? 'Provisioning...' : 'Abort'}
						</button>
					) : (
						<button
							class="btn-danger destroy-button"
							data-id={attackRange.attack_range_id}
							disabled={attackRange.status === 'destroying'}
						>
							{attackRange.status === 'destroying' ? 'Destroying...' : 'Destroy'}
						</button>
					)}
				</div>
				<div class="detail-grid">
					<div class="detail-item">
						<span class="detail-label">Attack Range ID:</span>
						<span class="detail-value">{attackRange.attack_range_id || 'Unknown'}</span>
					</div>
					<div class="detail-item">
						<span class="detail-label">Status:</span>
						<span class="detail-value">
							<span class={`status-badge status-${attackRange.status.replace(/_/g, '-')}`}>
								{attackRange.status}
							</span>
						</span>
					</div>
					<div class="detail-item">
						<span class="detail-label">Template:</span>
						<span class="detail-value">{attackRange.template_name || 'N/A'}</span>
					</div>
					<div class="detail-item">
						<span class="detail-label">Type:</span>
						<span class="detail-value">{attackRange.type}</span>
					</div>
					<div class="detail-item">
						<span class="detail-label">Created:</span>
						<span class="detail-value">{new Date(attackRange.created_time).toLocaleString()}</span>
					</div>
					{attackRange.start_time && (
						<div class="detail-item">
							<span class="detail-label">Started:</span>
							<span class="detail-value">{new Date(attackRange.start_time).toLocaleString()}</span>
						</div>
					)}
					{attackRange.end_time && (
						<div class="detail-item">
							<span class="detail-label">Ended:</span>
							<span class="detail-value">{new Date(attackRange.end_time).toLocaleString()}</span>
						</div>
					)}
					{attackRange.router_public_ip && (
						<div class="detail-item">
							<span class="detail-label">Router IP:</span>
							<span class="detail-value">{attackRange.router_public_ip}</span>
						</div>
					)}
				</div>
			</div>

			{attackRange.status === 'running' && attackRange.result && attackRange.result.architecture && attackRange.result.architecture.length > 0 && (
				<div class="detail-section">
					<h3>Architecture</h3>
					<div class="servers-list">
					{attackRange.result.architecture.map((server) => {
						const serverNameLower = server.name.toLowerCase();
						const isSplunk = serverNameLower === 'splunk';
						const isSoarOrPhantom = serverNameLower === 'soar' || serverNameLower === 'phantom';
						
						let serverUrl = null;
						let serverTitle = '';
						
						if (isSplunk && server.ip_last_octet !== undefined) {
							serverUrl = `http://10.0.2.${server.ip_last_octet}:8000`;
							serverTitle = 'Open Splunk in new tab';
						} else if (isSoarOrPhantom && server.ip_last_octet !== undefined) {
							serverUrl = `https://10.0.2.${server.ip_last_octet}:8443`;
							serverTitle = `Open ${server.name} in new tab`;
						}
						
						return (
						<div class="server-item">
							<div class="server-header">
								{serverUrl ? (
									<a 
										href={serverUrl} 
										target="_blank" 
										rel="noopener noreferrer"
										class="server-name server-name-clickable"
										title={serverTitle}
									>
										{server.name}
										<span class="external-link-icon">↗</span>
									</a>
								) : (
									<span class="server-name">{server.name}</span>
								)}
									{server.os_type && (
										<span class={`os-badge os-${server.os_type}`}>
											{server.os_type}
										</span>
									)}
								</div>
								<div class="server-details">
									{server.instance_type && (
										<div class="server-detail">
											<span class="detail-label">Instance:</span>
											<span class="detail-value">{server.instance_type}</span>
										</div>
									)}
									{server.ip_last_octet !== undefined && (
										<div class="server-detail">
											<span class="detail-label">IP:</span>
											<span class="detail-value">{server.private_ip || `10.0.2.${server.ip_last_octet}`}</span>
										</div>
									)}
									{server.roles && server.roles.length > 0 && (
										<div class="server-detail server-detail-roles">
											<span class="detail-label">Roles:</span>
											<span class="detail-value">{server.roles.join(', ')}</span>
										</div>
									)}
									{(server.zeek || server.zeek_monitor) && (
										<div class="server-detail">
											<span class="detail-label">Zeek:</span>
											<span class="detail-value">
												{server.zeek ? 'Installed' : ''}
												{server.zeek && server.zeek_monitor ? ' / ' : ''}
												{server.zeek_monitor ? 'Monitored' : ''}
											</span>
										</div>
									)}
								</div>
							</div>
							);
						})}
					</div>
				</div>
			)}

			{(attackRange.status === 'error' || attackRange.status === 'failed') && (
				<div class="detail-section error-section">
					<h3>Error</h3>
					{attackRange.error_phase && (
						<p class="error-phase">Phase: <strong>{attackRange.error_phase.replace(/_/g, ' ')}</strong></p>
					)}
					{attackRange.error && (
						<pre class="error-message-pre">{attackRange.error}</pre>
					)}
					{attackRange.traceback && (
						<details>
							<summary>Traceback</summary>
							<pre><code>{attackRange.traceback}</code></pre>
						</details>
					)}
					{attackRange.error_phase === 'build_lab' && (
						<div class="lab-retry-section">
							<p>Reconnect WireGuard if needed, then retry the lab playbook. You can also destroy this range from the button above.</p>
							{attackRange.router_public_ip && (
								<p>Router IP: <strong>{attackRange.router_public_ip}</strong></p>
							)}
							{attackRange.wireguard_config && (
								<div class="wireguard-config">
									<details data-attack-range-id={attackRange.attack_range_id}>
										<summary>WireGuard Config</summary>
										<pre><code>{attackRange.wireguard_config}</code></pre>
									</details>
								</div>
							)}
							<button
								class="btn-primary continue-button"
								data-id={attackRange.attack_range_id}
								data-label="Retry Lab Playbook"
							>
								Retry Lab Playbook
							</button>
						</div>
					)}
				</div>
			)}

			{attackRange.status === 'running' && attackRange.result?.default_credentials && attackRange.result.default_credentials.length > 0 && (
				<div class="detail-section credentials-section">
					<h3>Default credentials</h3>
					<p class="credentials-description">Usernames and passwords from the attack range config: Splunk, SOAR, Guacamole, and for Linux (SSH) and Windows (RDP) servers.</p>
					<div class="credentials-table-wrapper">
						<table class="credentials-table">
							<thead>
								<tr>
									<th>Service</th>
									<th>Server</th>
									<th>Username</th>
									<th>Password</th>
								</tr>
							</thead>
							<tbody>
								{attackRange.result.default_credentials.map((c) => (
									<tr>
										<td class="cred-service">{c.service}</td>
										<td class="cred-server">{c.server ?? '—'}</td>
										<td class="cred-username">{c.username}</td>
										<td class="cred-password">
											<div class="password-cell">
												<code>{c.password}</code>
												<button 
													type="button" 
													class="copy-password-btn" 
													data-password={c.password}
													title="Copy password"
												>
													Copy
												</button>
											</div>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			)}

			{attackRange.status === 'wait_for_vpn' && (
				<div class="detail-section vpn-section">
					<h3>VPN Configuration Required</h3>
					<p>Router IP: <strong>{attackRange.router_public_ip || 'N/A'}</strong></p>
					{attackRange.wireguard_config && (
						<div class="wireguard-config">
							<details data-attack-range-id={attackRange.attack_range_id}>
								<summary>WireGuard Config</summary>
								<pre><code>{attackRange.wireguard_config}</code></pre>
							</details>
						</div>
					)}
					<button
						class="btn-primary continue-button"
						data-id={attackRange.attack_range_id}
						data-label="Continue Build (After VPN Connection)"
					>
						Continue Build (After VPN Connection)
					</button>
				</div>
			)}

			{attackRange.status === 'running' && (
				<div class="detail-section share-section">
					<h3>Share</h3>
					<p class="share-description">Generate a new WireGuard client config for another user. The config is saved under general.sharing.</p>
					<button type="button" class="share-button" data-id={attackRange.attack_range_id}>
						Share
					</button>
					{attackRange.sharing && Object.keys(attackRange.sharing).length > 0 && (
						<div class="shared-configs">
							<h4>Shared configs</h4>
							{Object.entries(attackRange.sharing).map(([name, config]) => (
								<details class="shared-config-item">
									<summary>{name}</summary>
									<pre><code>{config}</code></pre>
								</details>
							))}
						</div>
					)}
				</div>
			)}

			{attackRange.status === 'running' && attackRange.result && attackRange.result.guacamole_info && (
				<div class="detail-section">
					<h3>Guacamole Access</h3>
					<p class="guacamole-description">Access remote servers via browser-based connections</p>
					<div class="guacamole-buttons">
						<a
							href={`http://${attackRange.result.guacamole_info.host_ip}:8080/guacamole`}
							target="_blank"
							rel="noopener noreferrer"
							class="guacamole-button guacamole-main-button"
							title="Open Guacamole main page"
						>
							Open Guacamole
							<span class="external-link-icon">↗</span>
						</a>
						{attackRange.result.guacamole_info.servers && attackRange.result.guacamole_info.servers.length > 0 && (
							<div class="guacamole-server-buttons">
								{attackRange.result.guacamole_info.servers.map((server) => {
									const guacamoleUrl = `http://${attackRange.result.guacamole_info.host_ip}:8080/guacamole`;
									const protocolLabel = server.protocol.toUpperCase();
									return (
										<a
											href={guacamoleUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="guacamole-button guacamole-server-button"
											title={`Connect to ${server.name} via ${protocolLabel}`}
										>
											{server.name}
											<span class="guacamole-protocol-badge">{protocolLabel}</span>
											<span class="external-link-icon">↗</span>
										</a>
									);
								})}
							</div>
						)}
					</div>
				</div>
			)}

			{attackRange.status === 'running' && attackRange.result && attackRange.result.architecture && (
				<div class="detail-section">
					<h3>Atomic Red Team Simulation</h3>
					<p class="simulation-description">Run Atomic Red Team techniques or individual atomic tests (technique ID + GUID) against servers in the attack range</p>
					<form id="simulate-form" class="simulation-form">
						<div class="form-group">
							<label for="target-server">Target Server:</label>
							<select id="target-server" name="target" required>
								<option value="">Select a server...</option>
								{attackRange.result.architecture.map((server) => (
									<option value={server.name}>
										{server.name} {server.os_type ? `(${server.os_type})` : ''}
									</option>
								))}
							</select>
						</div>
						<div class="form-group">
							<label for="techniques">Technique IDs:</label>
							<input
								type="text"
								id="techniques"
								name="techniques"
								placeholder="T1003.001, T1059.003"
								pattern="^$|^T[0-9]+(\.[0-9]+)?(,\s*T[0-9]+(\.[0-9]+)?)*$"
								title="Comma-separated MITRE ATT&CK technique IDs (e.g., T1003.001, T1059.003)"
							/>
							<small class="form-help">Optional. Runs all atomics for each technique ID.</small>
						</div>
						<div class="form-group">
							<label for="atomics">Atomics (technique:GUID):</label>
							<input
								type="text"
								id="atomics"
								name="atomics"
								placeholder="T1003.001:0be2230c-9ab3-4ac2-8826-3199b9a0ebf8"
								title="Comma-separated TECHNIQUE:GUID pairs from ART YAML"
							/>
							<small class="form-help">Optional. One atomic per pair (technique ID and auto_generated_guid). Provide at least one technique ID or atomic pair.</small>
						</div>
						<button type="submit" class="btn-primary simulate-button" id="simulate-button">
							Run Simulation
						</button>
					</form>
					<div id="simulation-result" class="simulation-result" style="display: none;"></div>
				</div>
			)}

			{attackRange.status === 'running' && attackRange.result && attackRange.result.architecture && attackRange.result.architecture.some((server) => {
				const name = (server.name || '').toLowerCase();
				const roles = server.roles || [];
				return name === 'splunk' || roles.some((r) => typeof r === 'string' && r.includes('ludus_ar_splunk'));
			}) && (
				<div class="detail-section">
					<h3>Splunk Event Export</h3>
					<p class="simulation-description">
						Export raw events from the attack range Splunk server via the management API. Requires VPN connectivity.
					</p>
					<form id="splunk-export-form" class="simulation-form">
						<div class="form-group">
							<label for="splunk-search">Search (SPL):</label>
							<textarea
								id="splunk-search"
								name="search"
								rows="3"
								required
								placeholder="index=* sourcetype=WinEventLog:Security"
							></textarea>
							<small class="form-help">SPL query with or without a leading <code>search</code> keyword.</small>
						</div>
						<div class="form-group">
							<label for="splunk-earliest">Earliest time:</label>
							<input
								type="text"
								id="splunk-earliest"
								name="earliest_time"
								value="-24h"
								required
								placeholder="-24h"
							/>
							<small class="form-help">Splunk time modifier (e.g. <code>-1h</code>, <code>-24h</code>, <code>-1d@d</code>).</small>
						</div>
						<div class="form-group">
							<label for="splunk-latest">Latest time:</label>
							<input
								type="text"
								id="splunk-latest"
								name="latest_time"
								value="now"
								required
								placeholder="now"
							/>
						</div>
						<div class="form-group">
							<label for="splunk-max-results">Max results:</label>
							<input
								type="number"
								id="splunk-max-results"
								name="max_results"
								value="1000"
								min="1"
								max="50000"
								required
							/>
						</div>
						<button type="submit" class="btn-primary simulate-button" id="splunk-export-button">
							Export Events
						</button>
					</form>
					<div id="splunk-export-result" class="simulation-result" style="display: none;"></div>
				</div>
			)}

			<dialog id="share-modal" class="share-modal">
				<h3>Share attack range</h3>
				<p class="share-modal-desc">Enter a name for the new WireGuard client. The playbook will run with an additional client and the config will be saved to general.sharing.</p>
				<form id="share-form">
					<div class="form-group">
						<label for="share-name">Name</label>
						<input type="text" id="share-name" name="name" required placeholder="e.g. alice" />
						<p id="share-error" class="share-error" style="display: none;"></p>
					</div>
					<div id="share-result" class="share-result" style="display: none;">
						<p class="share-success-msg">Saved to general.sharing.</p>
						<pre id="share-config-output"><code></code></pre>
						<button type="button" id="share-copy-btn" class="share-copy-btn">Copy config</button>
					</div>
					<div id="share-loading" class="share-loading" style="display: none;">
						<span class="share-spinner" aria-hidden="true"></span>
						<span class="share-loading-text">Sharing… Running playbooks and generating config. This may take a minute.</span>
					</div>
					<div class="share-modal-buttons">
						<button type="submit" id="share-submit-btn" class="share-submit-btn">Share</button>
						<button type="button" id="share-close-btn" class="share-close-btn">Cancel</button>
					</div>
				</form>
			</dialog>
		</div>
	)}
</BaseLayout>

<script>
	const API_BASE_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';
	
	document.addEventListener('DOMContentLoaded', () => {
		// Restore WireGuard config expand state from sessionStorage
		const wireguardDetails = document.querySelectorAll('.wireguard-config details');
		wireguardDetails.forEach((details) => {
			const attackRangeId = (details as HTMLElement).dataset.attackRangeId;
			if (attackRangeId) {
				const storageKey = `wireguard_expanded_${attackRangeId}`;
				const wasExpanded = sessionStorage.getItem(storageKey) === 'true';
				if (wasExpanded) {
					(details as HTMLDetailsElement).open = true;
				}
				
				// Save state when it changes
				details.addEventListener('toggle', () => {
					sessionStorage.setItem(storageKey, (details as HTMLDetailsElement).open ? 'true' : 'false');
				});
			}
		});

		// Handle password copy buttons
		const passwordCopyButtons = document.querySelectorAll('.copy-password-btn');
		passwordCopyButtons.forEach((button) => {
			button.addEventListener('click', async () => {
				const password = (button as HTMLElement).dataset.password;
				if (password && navigator.clipboard) {
					try {
						await navigator.clipboard.writeText(password);
						const btn = button as HTMLButtonElement;
						const originalText = btn.textContent;
						btn.textContent = 'Copied!';
						btn.classList.add('copied');
						setTimeout(() => {
							btn.textContent = originalText;
							btn.classList.remove('copied');
						}, 2000);
					} catch (err) {
						console.error('Failed to copy password:', err);
					}
				}
			});
		});

		// Handle share button and modal
		const shareButton = document.querySelector('.share-button');
		const shareModal = document.getElementById('share-modal') as HTMLDialogElement;
		const shareForm = document.getElementById('share-form') as HTMLFormElement;
		const shareNameInput = document.getElementById('share-name') as HTMLInputElement;
		const shareError = document.getElementById('share-error');
		const shareResult = document.getElementById('share-result');
		const shareConfigOutput = document.querySelector('#share-config-output code');
		const shareCopyBtn = document.getElementById('share-copy-btn');
		const shareSubmitBtn = document.getElementById('share-submit-btn');
		const shareCloseBtn = document.getElementById('share-close-btn');
		const shareLoading = document.getElementById('share-loading');

		if (shareButton && shareModal) {
			const attackRangeId = (shareButton as HTMLElement).dataset.id;
			shareButton.addEventListener('click', () => {
				shareError?.style && (shareError.style.display = 'none');
				shareResult?.style && (shareResult.style.display = 'none');
				shareLoading && (shareLoading.style.display = 'none');
				shareForm.reset();
				(shareSubmitBtn as HTMLButtonElement).textContent = 'Share';
				(shareSubmitBtn as HTMLButtonElement).style.display = '';
				(shareSubmitBtn as HTMLButtonElement).disabled = false;
				shareNameInput && (shareNameInput.disabled = false);
				(shareCloseBtn as HTMLButtonElement).disabled = false;
				shareModal.showModal();
			});

			shareCloseBtn?.addEventListener('click', () => {
				shareModal.close();
				if ((shareModal as any).__shareSuccess) {
					window.location.reload();
				}
			});
			shareModal?.addEventListener('click', (e) => {
				if (e.target === shareModal) shareModal.close();
			});

			shareForm?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const name = (shareNameInput?.value || '').trim();
				if (!name) {
					if (shareError) {
						shareError.textContent = 'Name is required';
						shareError.style.display = 'block';
					}
					return;
				}
				if (!attackRangeId) return;
				// Show loading state
				if (shareLoading) shareLoading.style.display = 'flex';
				if (shareSubmitBtn) (shareSubmitBtn as HTMLButtonElement).disabled = true;
				if (shareNameInput) shareNameInput.disabled = true;
				if (shareCloseBtn) (shareCloseBtn as HTMLButtonElement).disabled = true;
				if (shareError) shareError.style.display = 'none';
				try {
					const res = await fetch(`${API_BASE_URL}/attack-range/share`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ attack_range_id: attackRangeId, name }),
					});
					const data = await res.json();
					if (!res.ok) {
						throw new Error(data.details || data.message || 'Share failed');
					}
					if (shareConfigOutput) shareConfigOutput.textContent = data.config || '';
					if (shareResult) shareResult.style.display = 'block';
					(shareModal as any).__shareSuccess = true;
					if (shareSubmitBtn) (shareSubmitBtn as HTMLButtonElement).style.display = 'none';
				} catch (err) {
					if (shareError) {
						shareError.textContent = err instanceof Error ? err.message : 'Share failed';
						shareError.style.display = 'block';
					}
				} finally {
					if (shareLoading) shareLoading.style.display = 'none';
					if (shareSubmitBtn) (shareSubmitBtn as HTMLButtonElement).disabled = false;
					if (shareNameInput) shareNameInput.disabled = false;
					if (shareCloseBtn) (shareCloseBtn as HTMLButtonElement).disabled = false;
				}
			});

			shareCopyBtn?.addEventListener('click', () => {
				const code = shareConfigOutput?.textContent;
				if (code && navigator.clipboard) {
					navigator.clipboard.writeText(code);
					(shareCopyBtn as HTMLButtonElement).textContent = 'Copied!';
					setTimeout(() => { (shareCopyBtn as HTMLButtonElement).textContent = 'Copy config'; }, 2000);
				}
			});
		}

		// Handle abort button
		const abortButton = document.querySelector('.abort-button');
		if (abortButton) {
			abortButton.addEventListener('click', async () => {
				const attackRangeId = (abortButton as HTMLElement).dataset.id;
				if (!attackRangeId) return;

				const btn = abortButton as HTMLButtonElement;
				if (btn.disabled) return;
				
				if (!confirm(`Are you sure you want to abort the build for attack range ${attackRangeId}?`)) {
					return;
				}

				btn.disabled = true;
				btn.textContent = 'Aborting...';

				try {
					const response = await fetch(`${API_BASE_URL}/attack-range/abort`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({ attack_range_id: attackRangeId }),
					});

					if (!response.ok) {
						const error = await response.json();
						throw new Error(error.message || 'Failed to abort build');
					}

					// Reload page to show updated status (aborted)
					setTimeout(() => {
						window.location.reload();
					}, 1000);
				} catch (error) {
					alert(`Error: ${error instanceof Error ? error.message : 'Failed to abort build'}`);
					btn.disabled = false;
					btn.textContent = 'Abort';
				}
			});
		}

		// Handle destroy button
		const destroyButton = document.querySelector('.destroy-button');
		if (destroyButton) {
			destroyButton.addEventListener('click', async () => {
				const attackRangeId = (destroyButton as HTMLElement).dataset.id;
				if (!attackRangeId) return;
				
				if (!confirm(`Are you sure you want to destroy attack range ${attackRangeId}?`)) {
					return;
				}

				const btn = destroyButton as HTMLButtonElement;
				btn.disabled = true;
				btn.textContent = 'Destroying...';

				try {
					const response = await fetch(`${API_BASE_URL}/attack-range/destroy`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({ attack_range_id: attackRangeId }),
					});

					if (!response.ok) {
						const error = await response.json();
						throw new Error(error.message || 'Failed to destroy attack range');
					}

					// Redirect to list page after successful destroy
					setTimeout(() => {
						window.location.href = '/attack-ranges';
					}, 1000);
				} catch (error) {
					alert(`Error: ${error instanceof Error ? error.message : 'Failed to destroy attack range'}`);
					btn.disabled = false;
					btn.textContent = 'Destroy';
				}
			});
		}

		// Handle continue / retry lab playbook buttons
		document.querySelectorAll('.continue-button').forEach((continueButton) => {
			continueButton.addEventListener('click', async () => {
				const attackRangeId = (continueButton as HTMLElement).dataset.id;
				if (!attackRangeId) return;

				const btn = continueButton as HTMLButtonElement;
				const defaultLabel = btn.dataset.label || btn.textContent || 'Continue';
				btn.disabled = true;
				btn.textContent = 'Starting...';

				try {
					const response = await fetch(`${API_BASE_URL}/attack-range/build`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({ attack_range_id: attackRangeId }),
					});

					if (!response.ok) {
						const error = await response.json();
						throw new Error(error.message || 'Failed to continue build');
					}

					setTimeout(() => {
						window.location.reload();
					}, 1000);
				} catch (error) {
					alert(`Error: ${error instanceof Error ? error.message : 'Failed to continue build'}`);
					btn.disabled = false;
					btn.textContent = defaultLabel;
				}
			});
		});

		// Handle simulation form
		const simulateForm = document.getElementById('simulate-form') as HTMLFormElement;
		if (simulateForm) {
			// Get attack_range_id from URL or page context
			const attackRangeId = window.location.pathname.split('/').pop();
			if (!attackRangeId) {
				console.error('Error: Attack range ID not found');
				return;
			}
			
			simulateForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				
				const formData = new FormData(simulateForm);
				const target = formData.get('target') as string;
				const techniquesInput = (formData.get('techniques') as string) || '';
				const atomicsInput = (formData.get('atomics') as string) || '';
				
				const techniques = techniquesInput
					.split(',')
					.map(t => t.trim())
					.filter(t => t.length > 0);
				const atomics: { technique: string; guid: string }[] = [];
				for (const part of atomicsInput.split(',').map((p) => p.trim()).filter((p) => p.length > 0)) {
					const colon = part.indexOf(':');
					if (colon < 1) {
						alert(`Invalid atomic entry: ${part}. Use TECHNIQUE:GUID (e.g. T1003.001:0be2230c-...)`);
						return;
					}
					atomics.push({
						technique: part.slice(0, colon).trim(),
						guid: part.slice(colon + 1).trim(),
					});
				}
				
				if (techniques.length === 0 && atomics.length === 0) {
					alert('Please enter at least one technique ID or atomic (technique:GUID)');
					return;
				}
				
				const simulateButton = document.getElementById('simulate-button') as HTMLButtonElement;
				const resultDiv = document.getElementById('simulation-result') as HTMLDivElement;
				
				// Disable button and show loading state
				simulateButton.disabled = true;
				simulateButton.textContent = 'Running Simulation...';
				resultDiv.style.display = 'none';
				
				try {
					const response = await fetch(`${API_BASE_URL}/attack-range/simulate`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({
							attack_range_id: attackRangeId,
							target: target,
							techniques: techniques,
							atomics: atomics,
						}),
					});
					
					if (!response.ok) {
						const error = await response.json();
						throw new Error(error.message || 'Failed to run simulation');
					}
					
					const result = await response.json();
					
					// Show success message with execution output
					resultDiv.className = 'simulation-result simulation-success';
					let outputHtml = `
						<h4>Simulation Completed Successfully</h4>
						<p><strong>Target:</strong> ${result.target}</p>
						${result.techniques?.length ? `<p><strong>Techniques:</strong> ${result.techniques.join(', ')}</p>` : ''}
						${result.atomics?.length ? `<p><strong>Atomics:</strong> ${result.atomics.map((a) => `${a.technique}:${a.guid}`).join(', ')}</p>` : ''}
						<p>${result.message}</p>
					`;
					
					// Display execution output if available
					if (result.execution_output) {
						outputHtml += '<div class="execution-output">';
						outputHtml += '<h5>Execution Output:</h5>';
						for (const [host, outputs] of Object.entries(result.execution_output)) {
							outputHtml += `<div class="host-output">`;
							outputHtml += `<strong>Host: ${host}</strong>`;
							for (const output of outputs) {
								outputHtml += `<div class="technique-output">`;
								outputHtml += `<strong>Technique: ${output.technique}</strong>`;
								outputHtml += `<pre class="output-lines">${output.output.join('\n')}</pre>`;
								outputHtml += `</div>`;
							}
							outputHtml += `</div>`;
						}
						outputHtml += '</div>';
					}
					
					resultDiv.innerHTML = outputHtml;
					resultDiv.style.display = 'block';
					
					// Reset form
					simulateForm.reset();
				} catch (error) {
					// Show error message
					resultDiv.className = 'simulation-result simulation-error';
					resultDiv.innerHTML = `
						<h4>Simulation Failed</h4>
						<p>${error instanceof Error ? error.message : 'Failed to run simulation'}</p>
					`;
					resultDiv.style.display = 'block';
				} finally {
					// Re-enable button
					simulateButton.disabled = false;
					simulateButton.textContent = 'Run Simulation';
				}
			});
		}

		const splunkExportForm = document.getElementById('splunk-export-form') as HTMLFormElement;
		if (splunkExportForm) {
			const splunkAttackRangeId = window.location.pathname.split('/').pop();
			if (!splunkAttackRangeId) {
				console.error('Error: Attack range ID not found');
			} else {
				splunkExportForm.addEventListener('submit', async (e) => {
					e.preventDefault();
					const formData = new FormData(splunkExportForm);
					const search = (formData.get('search') as string)?.trim();
					const earliest_time = (formData.get('earliest_time') as string)?.trim() || '-24h';
					const latest_time = (formData.get('latest_time') as string)?.trim() || 'now';
					const max_results = parseInt(formData.get('max_results') as string, 10) || 1000;

					if (!search) {
						alert('Please enter a Splunk search query');
						return;
					}

					const exportButton = document.getElementById('splunk-export-button') as HTMLButtonElement;
					const resultDiv = document.getElementById('splunk-export-result') as HTMLDivElement;

					exportButton.disabled = true;
					exportButton.textContent = 'Exporting...';
					resultDiv.style.display = 'none';

					try {
						const response = await fetch(`${API_BASE_URL}/attack-range/splunk/export`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								attack_range_id: splunkAttackRangeId,
								search,
								earliest_time,
								latest_time,
								max_results,
							}),
						});

						if (!response.ok) {
							const error = await response.json();
							throw new Error(error.details || error.message || 'Failed to export Splunk events');
						}

						const result = await response.json();
						resultDiv.className = 'simulation-result simulation-success';
						const rawLines: string[] = result.events ?? [];
						const previewText = rawLines.slice(0, 5).join('\n');
						const fullText = rawLines.join('\n');
						const downloadId = `splunk-export-${Date.now()}`;

						resultDiv.innerHTML = `
							<h4>Export Completed</h4>
							<p><strong>Splunk host:</strong> ${result.splunk_host}</p>
							<p><strong>Search:</strong> <code>${result.search}</code></p>
							<p><strong>Time range:</strong> ${result.earliest_time} → ${result.latest_time}</p>
							<p><strong>Events:</strong> ${result.event_count}</p>
							<p>${result.message}</p>
							<button type="button" class="btn-primary simulate-button" id="${downloadId}">Download raw logs</button>
							<div class="execution-output">
								<h5>Preview (first 5 events)</h5>
								<pre class="output-lines">${previewText.replace(/</g, '&lt;')}</pre>
							</div>
						`;
						resultDiv.style.display = 'block';

						const downloadBtn = document.getElementById(downloadId);
						if (downloadBtn) {
							downloadBtn.addEventListener('click', () => {
								const blob = new Blob([fullText], { type: 'text/plain' });
								const url = URL.createObjectURL(blob);
								const a = document.createElement('a');
								a.href = url;
								a.download = `splunk-export-${splunkAttackRangeId}-${result.event_count}-events.txt`;
								a.click();
								URL.revokeObjectURL(url);
							});
						}
					} catch (error) {
						resultDiv.className = 'simulation-result simulation-error';
						resultDiv.innerHTML = `
							<h4>Export Failed</h4>
							<p>${error instanceof Error ? error.message : 'Failed to export Splunk events'}</p>
						`;
						resultDiv.style.display = 'block';
					} finally {
						exportButton.disabled = false;
						exportButton.textContent = 'Export Events';
					}
				});
			}
		}

		// Smart polling: only refresh when attack range status changes
		const attackRangeId = window.location.pathname.split('/').pop();
		if (attackRangeId) {
			let lastStatus: string | null = null;
			let lastTerraformRunning: boolean | null = null;
			let pollingInterval: number | null = null;
			
			// Get initial status from the page
			const statusElement = document.querySelector('.status-badge');
			if (statusElement) {
				lastStatus = statusElement.textContent?.trim() || null;
			}
			const initialAbortButton = document.querySelector('.abort-button') as HTMLButtonElement | null;
			if (initialAbortButton) {
				lastTerraformRunning = initialAbortButton.disabled;
			}

			const updateAbortButton = (terraformRunning: boolean) => {
				const btn = document.querySelector('.abort-button') as HTMLButtonElement | null;
				if (!btn) return;
				btn.disabled = terraformRunning;
				btn.textContent = terraformRunning ? 'Provisioning...' : 'Abort';
				btn.title = terraformRunning
					? 'Abort is not allowed while Terraform is provisioning infrastructure'
					: '';
			};
			
			// Only poll if status is not in a final state
			const finalStates = ['running', 'error'];
			const shouldPoll = lastStatus && !finalStates.includes(lastStatus);
			
			if (shouldPoll) {
				const checkStatus = async () => {
					try {
						const response = await fetch(`${API_BASE_URL}/attack-range/status/${attackRangeId}`);
						if (response.ok) {
							const data = await response.json();
							const currentStatus = data.status;
							const terraformRunning = Boolean(data.terraform_running);

							if (terraformRunning !== lastTerraformRunning) {
								updateAbortButton(terraformRunning);
								lastTerraformRunning = terraformRunning;
							}
							
							// Only reload if status changed
							if (currentStatus !== lastStatus) {
								window.location.reload();
								return;
							}
							
							// Update lastStatus for next check
							lastStatus = currentStatus;
							
							// Stop polling if we reached a final state
							if (finalStates.includes(currentStatus)) {
								if (pollingInterval !== null) {
									clearInterval(pollingInterval);
									pollingInterval = null;
								}
							}
						}
					} catch (error) {
						console.error('Error checking attack range status:', error);
					}
				};
				
				// Poll every 3 seconds
				pollingInterval = setInterval(checkStatus, 3000) as unknown as number;
				
				// Clean up on page unload
				window.addEventListener('beforeunload', () => {
					if (pollingInterval !== null) {
						clearInterval(pollingInterval);
					}
				});
			}
		}

		// Handle editable name
		const editableName = document.querySelector('.editable-name');
		if (editableName) {
			const attackRangeId = (editableName as HTMLElement).dataset.id;
			const titleH1 = editableName.querySelector('.editable-title') as HTMLElement;
			const editBtn = editableName.querySelector('.edit-name-btn') as HTMLButtonElement;
			let isEditing = false;

			const startEditing = () => {
				if (isEditing) return;
				isEditing = true;
				
				const currentName = titleH1.textContent || '';
				const input = document.createElement('input');
				input.type = 'text';
				input.value = currentName === 'Attack Range Details' ? '' : currentName;
				input.className = 'name-input';
				
				const buttonGroup = document.createElement('div');
				buttonGroup.className = 'name-edit-buttons';
				
				const saveBtn = document.createElement('button');
				saveBtn.textContent = 'Save';
				saveBtn.className = 'save-name-btn';
				
				const cancelBtn = document.createElement('button');
				cancelBtn.textContent = 'Cancel';
				cancelBtn.className = 'cancel-name-btn';
				
				buttonGroup.appendChild(saveBtn);
				buttonGroup.appendChild(cancelBtn);
				
				titleH1.style.display = 'none';
				editBtn.style.display = 'none';
				
				editableName.classList.add('editing');
				editableName.appendChild(input);
				editableName.appendChild(buttonGroup);
				
				input.focus();
				input.select();
				
				const finishEditing = () => {
					isEditing = false;
					input.remove();
					buttonGroup.remove();
					titleH1.style.display = '';
					editBtn.style.display = '';
					editableName.classList.remove('editing');
				};
				
				const saveName = async () => {
					const newName = input.value.trim();
					if (!attackRangeId) return;
					
					saveBtn.disabled = true;
					saveBtn.textContent = 'Saving...';
					
					try {
						const response = await fetch(`${API_BASE_URL}/attack-range/update-name`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ 
								attack_range_id: attackRangeId, 
								attack_range_name: newName || 'Attack Range Details'
							}),
						});
						
						if (!response.ok) {
							const error = await response.json();
							throw new Error(error.details || error.message || 'Failed to update name');
						}
						
						titleH1.textContent = newName || 'Attack Range Details';
						document.title = newName || `Attack Range ${attackRangeId}`;
						
						finishEditing();
					} catch (err) {
						alert(`Error: ${err instanceof Error ? err.message : 'Failed to update name'}`);
						saveBtn.disabled = false;
						saveBtn.textContent = 'Save';
					}
				};
				
				saveBtn.addEventListener('click', saveName);
				cancelBtn.addEventListener('click', finishEditing);
				input.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') {
						saveName();
					} else if (e.key === 'Escape') {
						finishEditing();
					}
				});
			};
			
			editBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				startEditing();
			});
		}
	});
</script>

